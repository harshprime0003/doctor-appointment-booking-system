# ---- Server ----
PORT=4800
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (client dev server, prod domain, etc.)
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
# DB_DRIVER controls where data is stored.
#   file  -> local JSON file store (default, zero setup)
#   mongo -> MongoDB / MongoDB Atlas cloud
DB_DRIVER=mongo

# Directory for the file-based store (relative to server root)
FILE_DB_DIR=./data

# Used only when DB_DRIVER=mongo
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=doctor_appointments
